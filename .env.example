# Copy to .env.local (development) or .env.production.
# Loaded in order: .env -> .env.<NODE_ENV> -> .env.local, later wins.
# A real exported environment variable always beats every file, so injected
# container config is never overridden by a stray .env.local in the image.

# Where workspace data lives. Overrides HybridProvider's default root.
WATIVE_DATA_ROOT=./data

# Hand-edited operator config (tenants.json, errors.json).
TEE_CONFIG_DIR=./config

# Machine-owned mutable state (state.json). Never hand-edit its contents.
TEE_STATE_DIR=./state

# Process-wide custody limits. Tenant-specific unlocked-workspace limits live
# in tenants.json. Token leases are bounded separately from core handles.
TEE_MAX_UNLOCKED_WORKSPACES=32
TEE_MAX_TOKEN_LEASES_PER_WORKSPACE=64

# Per-tenant token-mint attempts allowed in each rolling minute. Must be an
# integer between 1 and 10000; invalid values stop the service during boot.
TEE_MINT_RATE_LIMIT=10

# Workspace creation has its own KDF budget. A successfully deleted slug is
# held in a restart-safe cooldown before it can be created again.
TEE_WORKSPACE_CREATE_RATE_LIMIT=10
TEE_WORKSPACE_RECREATE_COOLDOWN_SEC=60

# Per-tenant fail-fast RPC admission and tee-owned operation deadline. The
# deadline may be lowered but cannot exceed the relay's 15-second hard limit.
TEE_MAX_RPC_OPERATIONS_PER_TENANT=8
TEE_RPC_DEADLINE_MS=15000

# Startup verifies that the native password-derivation backend is available and
# completes one fresh probe within this deadline. The service will not start if
# either check fails.
TEE_KDF_MAX_PROBE_MS=1000
# Emergency operator acknowledgement only. This still runs and reports the
# probe, but permits startup after an unsafe result.
# TEE_ALLOW_UNSAFE_KDF=1

PORT=3000

# NOTE: do not set NODE_ENV=test in a real deployment — wative-core documents
# that value as enabling reduced test KDF iterations.

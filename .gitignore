# ─────────────────────────────────────────────────────────────────────────
# Dependencies
# ─────────────────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/
.yarn/
.pnp.*

# ─────────────────────────────────────────────────────────────────────────
# Build output
# ─────────────────────────────────────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ─────────────────────────────────────────────────────────────────────────
# Tests
# ─────────────────────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─────────────────────────────────────────────────────────────────────────
# Logs
# ─────────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─────────────────────────────────────────────────────────────────────────
# SECRETS — live credentials. Only the *.example files are tracked.
# ─────────────────────────────────────────────────────────────────────────
# tenants.json holds API secret hashes and export public keys. The glob also
# catches tenants.production.json and friends, which a plain `tenants.json`
# rule would miss.
config/tenants*.json
!config/tenants.example.json
config/*.local.json

.env
.env.*
!.env.example

# Key material of any kind, wherever it lands.
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
secrets/

# ─────────────────────────────────────────────────────────────────────────
# WALLET DATA AND SERVICE STATE — never committed.
#
# Encrypted workspace containers are still key material: committing them
# publishes ciphertext that is one password away from live funds, and git
# history makes that permanent. `data/` is the WATIVE_DATA_ROOT default from
# .env.example; `.wative2/` is wative-core's own default when no root is set.
# ─────────────────────────────────────────────────────────────────────────
data/
.wative2/
state/

# ─────────────────────────────────────────────────────────────────────────
# Editors and OS
# ─────────────────────────────────────────────────────────────────────────
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
.idea/
*.swp
*.swo
*~

# ─────────────────────────────────────────────────────────────────────────
# Scratch
# ─────────────────────────────────────────────────────────────────────────
tmp/
temp/
*.tmp
*.bak
*.orig

# ─────────────────────────────────────────────────────────────────────────
# Project docs are kept out of the repo (set deliberately — see note in the
# handover). docs/DESIGN.md lives on disk but is NOT committed.
# ─────────────────────────────────────────────────────────────────────────
docs/
